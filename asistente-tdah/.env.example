# ─── Copia este archivo como .env y completa los valores ───────────────────────

# Telegram: crea tu bot con @BotFather y pega el token.
TELEGRAM_BOT_TOKEN=
# Déjalo vacío la primera vez: escríbele al bot y te responde con tu número de chat.
TELEGRAM_CHAT_ID=

# Túnel HTTPS para que Telegram llegue a tu n8n (gratis en ngrok.com → "Domains").
NGROK_AUTHTOKEN=
NGROK_DOMAIN=tu-dominio.ngrok-free.app

# Google Calendar (se puede completar después). Crea un cliente OAuth en Google Cloud Console
# (tipo "Aplicación web", URI de redirección: https://TU_NGROK_DOMAIN/rest/oauth2-credential/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_ID=primary

# IA local
OLLAMA_MODEL=qwen2.5:7b
WHISPER_MODELO=small

# Zona horaria (afecta fechas, recordatorios y resúmenes)
ZONA_HORARIA=America/Santiago

# Claves internas: usa solo letras y números (por ejemplo: openssl rand -hex 24)
POSTGRES_USER=asistente
POSTGRES_PASSWORD=
N8N_ENCRYPTION_KEY=
PANEL_TOKEN=
PANEL_URL=http://localhost:8080

# Pon "true" para volver a cargar los workflows desde la carpeta n8n/ (sobrescribe cambios hechos en n8n).
REIMPORTAR_WORKFLOWS=false
