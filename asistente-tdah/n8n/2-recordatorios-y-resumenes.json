      "position": [
        440,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "return $input.all().filter(i => i.json && i.json.r && i.json.r.id);"
      }
    },
    {
      "id": "ab146fe8-24e9-43a5-a480-b69257954d82",
