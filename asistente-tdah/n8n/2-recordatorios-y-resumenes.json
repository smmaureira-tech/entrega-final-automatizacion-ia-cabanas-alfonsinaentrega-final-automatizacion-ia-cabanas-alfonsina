        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ chat_id: $env.TELEGRAM_CHAT_ID, text: String($json.r.texto).slice(0, 4000), parse_mode: 'HTML', disable_web_page_preview: true, reply_markup: $json.r.teclado || undefined }) }}",
        "options": {}
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
